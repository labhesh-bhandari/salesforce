<apex:page
    controller="EmailController">

    <apex:form
        enctype="multipart/form-data">

        <apex:pageMessages/>


        <apex:pageBlock
            title="Email Notification System">


            <apex:pageBlockSection
                columns="1">


                <apex:inputText
                    value="{!recipientEmail}"
                    label="Recipient Email"/>


                <apex:inputText
                    value="{!subject}"
                    label="Subject"/>


                <apex:inputTextarea
                    value="{!messageBody}"
                    label="Message Body"/>



                <!-- File Upload -->
                <apex:inputFile

                    value="{!uploadedBody}"

                    filename="{!uploadedFileName}"

                />


            </apex:pageBlockSection>



            <apex:commandButton

                value="Send Email"

                action="{!sendEmail}"

            />


        </apex:pageBlock>

    </apex:form>

</apex:page>