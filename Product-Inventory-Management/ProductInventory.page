<apex:page controller="ProductController">

    <apex:form>

        <h1>Product Inventory Management System</h1>


        <!-- Form -->
        <apex:pageBlock title="Product Form">

            <apex:pageBlockSection columns="1">

                <apex:inputField value="{!prod.Name}" />

                <apex:inputField value="{!prod.Serial_No__c}" />

                <apex:inputField value="{!prod.Quantity__c}" />

                <apex:inputField value="{!prod.Manufacture_Date__c}" />

                <apex:inputField value="{!prod.Expiry_Date__c}" />

            </apex:pageBlockSection>


            <!-- CREATE -->
            <apex:commandButton
                rendered="{!!isEditMode}"
                value="Save Product"
                action="{!saveProduct}"
                rerender="productTable"/>


            <!-- UPDATE -->
            <apex:commandButton
                rendered="{!isEditMode}"
                value="Update Product"
                action="{!updateProduct}"
                rerender="productTable"/>

        </apex:pageBlock>



        <!-- Table -->
        <apex:pageBlock
            title="Product Records"
            id="productTable">

            <apex:pageBlockTable
                value="{!productList}"
                var="p">

                <apex:column value="{!p.Name}" />

                <apex:column value="{!p.Serial_No__c}" />

                <apex:column value="{!p.Quantity__c}" />

                <apex:column value="{!p.Manufacture_Date__c}" />

                <apex:column value="{!p.Expiry_Date__c}" />


                <!-- EDIT -->
                <apex:column>

                    <apex:commandLink
                        value="Edit"
                        action="{!editProduct}">

                        <apex:param
                            name="id"
                            value="{!p.Id}" />

                    </apex:commandLink>

                </apex:column>


                <!-- DELETE -->
                <apex:column>

                    <apex:commandLink
                        value="Delete"
                        action="{!deleteProduct}">

                        <apex:param
                            name="id"
                            value="{!p.Id}" />

                    </apex:commandLink>

                </apex:column>

            </apex:pageBlockTable>

        </apex:pageBlock>

    </apex:form>

</apex:page>